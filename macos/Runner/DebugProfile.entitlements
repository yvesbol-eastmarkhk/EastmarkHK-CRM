<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.eastmarkhk.shared</string>
	</array>
	<!-- Requis par flutter_secure_storage dès qu’un App Group est déclaré. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.com.eastmarkhk.shared</string>
	</array>
	<!-- Debug : sandbox off pour lire la licence e-Invoicing installée (même modèle que e-Invoicing debug). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
