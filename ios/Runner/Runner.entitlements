<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Partagé avec EastmarkHK e-Invoicing (iOS/iPadOS) — détection de licence,
	     même App Group que la version macOS (group.com.eastmarkhk.shared). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.eastmarkhk.shared</string>
	</array>
</dict>
</plist>
